# =============================================================================
# NOVAGON - .gitignore (Bảo mật tối đa & Cho phép Upload Bản cài đặt EXE)
# =============================================================================

# 1. BẢO MẬT, CHỨNG CHỈ SỐ & THÔNG TIN NHẠY CẢM (CREDENTIALS & SSL)
# -----------------------------------------------------------------------------
etc/ssl/*
!etc/ssl/.gitkeep
*.key
*.pem
*.pfx
*.crt
*.csr
*.cer

# Biến môi trường & cấu hình bí mật
.env
.env.*
!.env.example
*.local
secrets.json

# Cơ sở dữ liệu, dữ liệu MariaDB/MySQL và bản sao lưu
backups/*
!backups/.gitkeep
*.bak
*.backup
*.dump
*.sql
*.sqlite
*.sqlite3
*.db
*.err
*.pid

# 2. RUNTIME BINARIES & DỮ LIỆU CÁ NHÂN (PORTABLE RUNTIMES)
# -----------------------------------------------------------------------------
# Binary các engine: Nginx, PHP, MariaDB, Nodejs, Redis, Composer...
bin/
/bin/

# Thư mục web dự án cá nhân (chỉ giữ trang chào mừng mặc định)
www/*
!www/.gitkeep
!www/index.php

# Ứng dụng bên thứ 3 và cache tải về
etc/apps/*
!etc/apps/.gitkeep
etc/cache/*
!etc/cache/.gitkeep

# Cấu hình Virtual Host tự động sinh
etc/nginx/sites-enabled/*
!etc/nginx/sites-enabled/.gitkeep

# 3. NHẬT KÝ, TIẾN TRÌNH & CRASH LOGS
# -----------------------------------------------------------------------------
logs/*
!logs/.gitkeep
*.log
crash.log
*.tmp

# 4. .NET BUILD ARTIFACTS & IDE CACHE
# -----------------------------------------------------------------------------
# Thư mục build trung gian
[Bb]in/
[Oo]bj/
*.dll
*.pdb
*.msi
*.nupkg

# Visual Studio / VS Code / JetBrains Rider cache
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*_wpftmp.csproj
project.lock.json
project.assets.json

# Hệ điều hành
Thumbs.db
Desktop.ini
.DS_Store

# 5. ĐÓNG GÓI BẢN CÀI ĐẶT (DISTRIBUTION & INSTALLER)
# -----------------------------------------------------------------------------
# Chặn toàn bộ thư mục build và bộ cài đặt (sử dụng GitHub Releases để lưu trữ bản cài đặt lớn)
dist/
*.exe
*.zip
*.tar.gz
*.7z
*.rar
