<Window x:Class="Novagon.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="{DynamicResource App_Title}"
        Height="570" Width="920"
        MinHeight="480" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#f1f5f9"
        Foreground="#1e293b"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 1. Normal Action Button (Reload, Terminal, Root www, Xóa Logs) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#94a3b8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0284c7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0369a1"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0369a1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#075985"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#cbd5e1"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. Primary Start Button (Độc lập, không bị đè hover) -->
        <Style x:Key="PrimaryStartButton" TargetType="Button">
            <Setter Property="Background" Value="#15803d"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#166534"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#166534"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#14532d"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14532d"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#052e16"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#15803d"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#166534"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Stop Button -->
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Background" Value="#dc2626"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#b91c1c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#b91c1c"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#991b1b"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#991b1b"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7f1d1d"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#cbd5e1"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Warning Admin Button -->
        <Style x:Key="WarningAdminButton" TargetType="Button">
            <Setter Property="Background" Value="#d97706"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#b45309"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#b45309"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#92400e"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#92400e"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Action Button for Grid Cells (High Contrast Blue) -->
        <Style x:Key="PrimaryMiniButton" TargetType="Button">
            <Setter Property="Background" Value="#0284c7"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#0369a1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0369a1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#cbd5e1"/>
                                <Setter Property="Foreground" Value="#15803d"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Danger Action Button for Delete (High Contrast Red) -->
        <Style x:Key="DangerMiniButton" TargetType="Button">
            <Setter Property="Background" Value="#dc2626"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#b91c1c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#b91c1c"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#991b1b"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#991b1b"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7f1d1d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Success Action Button (Green #16a34a) -->
        <Style x:Key="SuccessMiniButton" TargetType="Button">
            <Setter Property="Background" Value="#16a34a"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#15803d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15803d"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Purple Action Button (Indigo #6366f1) -->
        <Style x:Key="PurpleMiniButton" TargetType="Button">
            <Setter Property="Background" Value="#6366f1"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#4f46e5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4f46e5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4338ca"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338ca"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral Mini Action Button (Slate / Gray) -->
        <Style x:Key="NeutralMiniButton" TargetType="Button">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e2e8f0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94a3b8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#cbd5e1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Icon Button Style -->
        <Style x:Key="SettingsIconButton" TargetType="Button">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94a3b8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#e2e8f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Service Card Style (Classic Clean White Border) -->
        <Style x:Key="ServiceCard" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderBrush" Value="#94a3b8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- High Contrast GridView Column Header -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#e2e8f0"/>
            <Setter Property="Foreground" Value="#0f172a"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Action Bar -->
            <RowDefinition Height="Auto"/> <!-- Service Status Cards -->
            <RowDefinition Height="*"/>    <!-- Content Tabs -->
        </Grid.RowDefinitions>

        <!-- Taskbar System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/app.ico"
                        ToolTipText="NOVAGON - Local Development Environment"
                        TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource Btn_StartAll}" Click="BtnStartAll_Click"/>
                    <MenuItem Header="{DynamicResource Btn_StopAll}" Click="BtnStopAll_Click"/>
                    <MenuItem Header="{DynamicResource Btn_ReloadVHosts}" Click="BtnReload_Click"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Tray_Db}" Click="BtnDatabase_Click"/>
                    <MenuItem Header="{DynamicResource Tray_Mailpit}" Click="BtnMailpit_Click"/>
                    <MenuItem Header="{DynamicResource Tray_Terminal}" Click="BtnTerminal_Click"/>
                    <MenuItem Header="{DynamicResource Tray_RootWww}" Click="BtnOpenWww_Click"/>
                    <MenuItem Header="{DynamicResource Menu_ChangeRootDir}" Click="MenuChangeRootDir_Click"/>
                    <MenuItem Header="{DynamicResource Tray_Settings}" Click="MenuSettings_Click"/>
                    <MenuItem Header="{DynamicResource Tray_OpenApp}" Click="MenuShowDashboard_Click"/>
                    <MenuItem Header="{DynamicResource Tray_Exit}" Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- 1. Header with Language Switcher -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0" ClipToBounds="True">
                    <Image Source="/Assets/novagon.png" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="Novagon" FontSize="20" FontWeight="Bold" Foreground="#0f172a" VerticalAlignment="Center"/>
                <Border Background="#e2e8f0" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="v1.0.0" FontSize="11" FontWeight="Bold" Foreground="#0f172a"/>
                </Border>
                <Button x:Name="BtnElevate" Content="{DynamicResource Admin_Badge}"
                        Style="{StaticResource WarningAdminButton}" Visibility="Collapsed" Click="BtnElevate_Click" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Settings Button (Icon bánh răng) -->
            <Button x:Name="BtnSettings" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource SettingsIconButton}" Click="BtnSettings_Click"
                    ToolTip="{DynamicResource Menu_Settings}">
                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                      Fill="#334155" Stretch="Uniform" Width="18" Height="18"/>
            </Button>
        </Grid>

        <!-- 2. Action Bar (Classic High Contrast Button Row) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="BtnStartAll" Style="{StaticResource PrimaryStartButton}" Click="BtnStartAll_Click" Padding="16,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#ef4444" Stroke="#ffffff" StrokeThickness="1.5" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Text="{DynamicResource Overall_Stopped}" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnStopAll" Content="{DynamicResource Btn_StopAll}" Style="{StaticResource StopButton}" Click="BtnStopAll_Click" IsEnabled="False" Padding="16,8"/>
            <Button x:Name="BtnReload" Content="{DynamicResource Btn_ReloadVHosts}" Style="{StaticResource ActionButton}" Click="BtnReload_Click"/>
            <Button x:Name="BtnDatabase" Content="{DynamicResource Btn_Database}" Style="{StaticResource ActionButton}" Click="BtnDatabase_Click"/>
            <Button x:Name="BtnMailpit" Content="Mailpit" Style="{StaticResource ActionButton}" Click="BtnMailpit_Click" ToolTip="Mailpit (127.0.0.1:8025)"/>
            <Button x:Name="BtnTerminal" Content="{DynamicResource Btn_Terminal}" Style="{StaticResource ActionButton}" Click="BtnTerminal_Click"/>
            <Button x:Name="BtnOpenWww" Content="{DynamicResource Btn_RootWww}" Style="{StaticResource ActionButton}" Click="BtnOpenWww_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Tray_RootWww}" Click="BtnOpenWww_Click"/>
                        <MenuItem Header="{DynamicResource Menu_ChangeRootDir}" Click="MenuChangeRootDir_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>

        <!-- 3. Service Cards (4 Card trạng thái chi tiết, Độ tương phản cao) -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Web Server -->
            <Border Grid.Column="0" Style="{StaticResource ServiceCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Svc_WebServer}" FontSize="11" FontWeight="Bold" Foreground="#0369a1" VerticalAlignment="Center"/>
                        <Border x:Name="BadgeWeb" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtStatusWeb" Text="{DynamicResource Status_Stopped_Badge}" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TxtWebTitle" Text="Nginx" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtWebPort" Text="Port: 80, 443" FontSize="11" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Database -->
            <Border Grid.Column="1" Style="{StaticResource ServiceCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Svc_Database}" FontSize="11" FontWeight="Bold" Foreground="#0369a1" VerticalAlignment="Center"/>
                        <Border x:Name="BadgeDb" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtStatusDb" Text="{DynamicResource Status_Stopped_Badge}" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TxtDbTitle" Text="MySQL / MariaDB" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDbPort" Text="Port: 3306" FontSize="11" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: PHP FastCGI -->
            <Border Grid.Column="2" Style="{StaticResource ServiceCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Svc_PhpFastCgi}" FontSize="11" FontWeight="Bold" Foreground="#0369a1" VerticalAlignment="Center"/>
                        <Border x:Name="BadgePhp" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtStatusPhp" Text="{DynamicResource Status_Stopped_Badge}" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TxtPhpTitle" Text="PHP" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtPhpPort" Text="Port: 9054" FontSize="11" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Redis Cache -->
            <Border Grid.Column="3" Style="{StaticResource ServiceCard}" Margin="0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Svc_Redis}" FontSize="11" FontWeight="Bold" Foreground="#0369a1" VerticalAlignment="Center"/>
                        <Border x:Name="BadgeRedis" Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3" Padding="5,1" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtStatusRedis" Text="{DynamicResource Status_Stopped_Badge}" FontSize="10" FontWeight="Bold" Foreground="#64748b"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="TxtRedisTitle" Text="Redis Server" FontSize="15" FontWeight="Bold" Foreground="#0f172a" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtRedisPort" Text="Port: 6379" FontSize="11" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Content Tabs (Classic Clean Tabs) -->
        <TabControl Grid.Row="3" Background="#ffffff" BorderBrush="#94a3b8" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#e2e8f0" BorderBrush="#94a3b8" BorderThickness="1,1,1,0"
                                        Padding="16,8" Margin="0,0,3,-1" CornerRadius="4,4,0,0">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#ffffff"/>
                                        <Setter Property="Foreground" Value="#0284c7"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#0f172a"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Virtual Hosts -->
            <TabItem Header="{DynamicResource Tab_VHosts}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource Desc_VHosts}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#1e293b" Margin="0,0,0,8"/>

                    <ListView x:Name="ListVHosts" Grid.Row="1" Background="#ffffff" Foreground="#0f172a"
                              BorderThickness="1" BorderBrush="#94a3b8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Col_Domain}" Width="170" DisplayMemberBinding="{Binding Domain}"/>
                                <GridViewColumn Header="{DynamicResource Col_DocRoot}" Width="280" DisplayMemberBinding="{Binding DocumentRoot}"/>
                                <GridViewColumn Header="{DynamicResource Col_Actions}" Width="340">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource Btn_OpenWebsite}" Style="{StaticResource PrimaryMiniButton}"
                                                        Click="BtnOpenDomain_Click" Tag="{Binding Domain}" Margin="0,0,5,0"
                                                        ToolTip="{DynamicResource Tooltip_OpenBrowser}"/>
                                                <Button Content="{DynamicResource Btn_OpenFolder}" Style="{StaticResource NeutralMiniButton}"
                                                        Click="BtnOpenProjectFolder_Click" Tag="{Binding ProjectPath}" Margin="0,0,5,0"
                                                        ToolTip="{DynamicResource Tooltip_OpenFolder}"/>
                                                <Button Content="{DynamicResource Btn_OpenVsCode}" Style="{StaticResource NeutralMiniButton}"
                                                        Click="BtnOpenVsCode_Click" Tag="{Binding ProjectPath}" Margin="0,0,5,0"
                                                        ToolTip="{DynamicResource Tooltip_OpenVsCode}"/>
                                                <Button Content="{DynamicResource Btn_OpenTerminal}" Style="{StaticResource NeutralMiniButton}"
                                                        Click="BtnOpenProjectTerminal_Click" Tag="{Binding ProjectPath}" Margin="0,0,5,0"
                                                        ToolTip="{DynamicResource Tooltip_OpenTerminal}"/>
                                                <Button Content="{DynamicResource Btn_DeleteProject}" Style="{StaticResource DangerMiniButton}"
                                                        Click="BtnDeleteProject_Click" Tag="{Binding}"
                                                        ToolTip="{DynamicResource Tooltip_DeleteProject}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Tab 2: Quick Apps (Tạo dự án 1-Click chuẩn Novagon) -->
            <TabItem Header="{DynamicResource Tab_QuickApp}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header hướng dẫn & Cấu hình dự án -->
                        <Border Grid.Row="0" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource Lbl_ProjectName}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtQuickAppName" Width="220" Padding="8,4" FontSize="13" Text="my-project"
                                             BorderBrush="#94a3b8" Foreground="#0f172a" FontWeight="Bold"/>
                                    <TextBlock Text=".test" VerticalAlignment="Center" FontWeight="Bold" Foreground="#0284c7" Margin="6,0,16,0"/>

                                    <Border Background="#e0f2fe" BorderBrush="#7dd3fc" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Hint_VHostAuto}" FontSize="11" FontWeight="SemiBold" Foreground="#0369a1"/>
                                    </Border>
                                </StackPanel>

                                <!-- Tùy chọn cấu hình -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Lbl_ConfigOptions}" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkCreateDb" Content="{DynamicResource Chk_AutoCreateDb}" IsChecked="True"
                                              VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0f172a" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="ChkOpenBrowser" Content="{DynamicResource Chk_OpenBrowser}" IsChecked="True"
                                              VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0f172a" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="ChkOpenFolder" Content="{DynamicResource Chk_OpenExplorer}" IsChecked="False"
                                              VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0f172a"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4 Cards: Frameworks & Apps (Grid 2 cột x 2 hàng) -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: WordPress -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,6,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Card_Wp_Title}" FontSize="16" FontWeight="Bold" Foreground="#0284c7"/>
                                        <Border Background="#e0f2fe" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="{DynamicResource Card_Wp_Badge}" FontSize="11" FontWeight="Bold" Foreground="#0369a1"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Card_Wp_Desc}"
                                               TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,12" Height="50"/>
                                    <Button Content="{DynamicResource Btn_CreateWp}" Style="{StaticResource PrimaryMiniButton}"
                                            Padding="14,7" HorizontalAlignment="Left" Click="BtnCreateWordPress_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Laravel -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="6,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Card_Laravel_Title}" FontSize="16" FontWeight="Bold" Foreground="#ef4444"/>
                                        <Border Background="#fee2e2" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="{DynamicResource Card_Laravel_Badge}" FontSize="11" FontWeight="Bold" Foreground="#b91c1c"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Card_Laravel_Desc}"
                                               TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,12" Height="50"/>
                                    <Button Content="{DynamicResource Btn_CreateLaravel}" Style="{StaticResource DangerMiniButton}"
                                            Padding="14,7" HorizontalAlignment="Left" Click="BtnCreateLaravel_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Blank PHP -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,6,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Card_Php_Title}" FontSize="16" FontWeight="Bold" Foreground="#16a34a"/>
                                        <Border Background="#dcfce7" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="{DynamicResource Card_Php_Badge}" FontSize="11" FontWeight="Bold" Foreground="#15803d"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Card_Php_Desc}"
                                               TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,12" Height="50"/>
                                    <Button Content="{DynamicResource Btn_CreatePhp}" Style="{StaticResource SuccessMiniButton}"
                                            Padding="14,7" HorizontalAlignment="Left" Click="BtnCreateBlankPhp_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: HTML5 / Static Web -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="6" Padding="14" Margin="6,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Card_Static_Title}" FontSize="16" FontWeight="Bold" Foreground="#6366f1"/>
                                        <Border Background="#ede9fe" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <TextBlock Text="{DynamicResource Card_Static_Badge}" FontSize="11" FontWeight="Bold" Foreground="#6d28d9"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Card_Static_Desc}"
                                               TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,0,0,12" Height="50"/>
                                    <Button Content="{DynamicResource Btn_CreateStatic}" Style="{StaticResource PurpleMiniButton}"
                                            Padding="14,7" HorizontalAlignment="Left" Click="BtnCreateStaticWeb_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Tiến trình -->
                        <StackPanel Grid.Row="2" x:Name="PnlQuickAppProgress" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock x:Name="TxtQuickAppStatus" Text="{DynamicResource Msg_Processing}" FontSize="12" FontWeight="Bold" Foreground="#0369a1" Margin="0,0,0,6"/>
                            <ProgressBar x:Name="PbQuickApp" Height="8" Background="#e2e8f0" Foreground="#16a34a" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Runtime Configuration & Extensions -->
            <TabItem Header="{DynamicResource Tab_Runtimes}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="{DynamicResource Lbl_SelectPhp}" FontSize="13" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbPhpVersions" Width="320" HorizontalAlignment="Left" Margin="0,0,0,14"
                                  FontSize="13" Foreground="#0f172a" SelectionChanged="CmbPhpVersions_SelectionChanged"/>

                        <TextBlock Text="{DynamicResource Lbl_SelectDb}" FontSize="13" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbMySqlVersions" Width="320" HorizontalAlignment="Left" Margin="0,0,0,14"
                                  FontSize="13" Foreground="#0f172a" SelectionChanged="CmbMySqlVersions_SelectionChanged"/>

                        <TextBlock Text="{DynamicResource Lbl_WebEngine}" FontSize="13" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton x:Name="RbNginx" Content="Nginx" IsChecked="True" FontSize="13" FontWeight="SemiBold" Foreground="#0f172a" Margin="0,0,16,0"/>
                            <RadioButton x:Name="RbApache" Content="Apache" FontSize="13" FontWeight="SemiBold" Foreground="#0f172a"/>
                        </StackPanel>

                        <!-- PHP Extension Manager (Bật/tắt extension 1-click chuẩn Novagon) -->
                        <Border Background="#f8fafc" BorderBrush="#94a3b8" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Lbl_PhpExtTitle}"
                                           FontSize="13" FontWeight="Bold" Foreground="#0369a1" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ListPhpExtensions">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}"
                                                      ToolTip="{Binding Description}"
                                                      FontWeight="SemiBold" Foreground="#0f172a" Margin="0,4,12,4"
                                                      Click="ChkExtension_Click" Tag="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Package Hub (Kho Gói Runtimes 1-Click) -->
            <TabItem Header="{DynamicResource Tab_Hub}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource Lbl_HubTitle}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#1e293b" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- Category Filter Dropdown -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Lbl_FilterCategory}" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbPkgCategoryFilter" Width="170" Height="28" FontSize="12" FontWeight="SemiBold"
                                      SelectionChanged="CmbPkgCategoryFilter_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Filter_All}" Tag="all" IsSelected="True"/>
                                <ComboBoxItem Content="PHP" Tag="php"/>
                                <ComboBoxItem Content="MySQL / MariaDB" Tag="mysql"/>
                                <ComboBoxItem Content="Redis" Tag="redis"/>
                                <ComboBoxItem Content="Node.js" Tag="nodejs"/>
                                <ComboBoxItem Content="{DynamicResource Filter_Tools}" Tag="tools"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="ListPackages" Grid.Row="1" Background="#ffffff" Foreground="#0f172a"
                              BorderThickness="1" BorderBrush="#94a3b8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Col_PkgName}" Width="310" DisplayMemberBinding="{Binding DisplayName}"/>
                                <GridViewColumn Header="{DynamicResource Col_PkgCat}" Width="75" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="{DynamicResource Col_PkgSize}" Width="85" DisplayMemberBinding="{Binding SizeDescription}"/>
                                <GridViewColumn Header="{DynamicResource Col_Actions}" Width="210">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Khi CHƯA cài đặt: Hiển thị nút Tải về (1-Click) -->
                                                <Button Content="{Binding ActionText}"
                                                        Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                                                        Style="{StaticResource PrimaryMiniButton}"
                                                        Click="BtnDownloadPackage_Click" Tag="{Binding}"/>

                                                <!-- Khi ĐÃ cài đặt: Badge Đã cài đặt + Nút Gỡ cài đặt -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                    <Border Background="#f1f5f9" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Status_Installed_Badge}" FontSize="11" FontWeight="Bold" Foreground="#15803d"/>
                                                    </Border>
                                                    <Button Content="{DynamicResource Btn_UninstallPkg}"
                                                            Style="{StaticResource DangerMiniButton}"
                                                            Click="BtnUninstallPackage_Click" Tag="{Binding}"
                                                            ToolTip="{DynamicResource Tooltip_UninstallPkg}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" x:Name="PnlDownloadProgress" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtDownloadStatus" Text="{DynamicResource Msg_Processing}" FontSize="12" FontWeight="Bold" Foreground="#0369a1" Margin="0,0,0,4"/>
                        <ProgressBar x:Name="PbDownload" Height="8" Background="#e2e8f0" Foreground="#0284c7" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 5: Logs -->
            <TabItem Header="{DynamicResource Tab_Logs}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtLogs" Grid.Row="0" Background="#ffffff" Foreground="#0f172a"
                             FontFamily="Consolas" FontSize="12" FontWeight="Medium" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderBrush="#94a3b8"
                             Padding="8"/>

                    <Button Grid.Row="1" Content="{DynamicResource Btn_ClearLogs}" HorizontalAlignment="Right" Margin="0,8,0,0"
                            Style="{StaticResource ActionButton}" Click="BtnClearLogs_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
