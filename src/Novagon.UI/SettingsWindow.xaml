<Window x:Class="Novagon.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Height="410" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8fafc"
        Foreground="#1e293b"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Primary Action Button -->
        <Style x:Key="PrimarySaveButton" TargetType="Button">
            <Setter Property="Background" Value="#0284c7"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#0369a1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0369a1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#075985"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral Cancel Button -->
        <Style x:Key="NeutralButton" TargetType="Button">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#f1f5f9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94a3b8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content Card -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header with Gear Icon -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
            <Border Background="#e0f2fe" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                      Fill="#0284c7" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Settings_Title}" FontSize="16" FontWeight="Bold" Foreground="#0f172a"/>
                <TextBlock Text="{DynamicResource Settings_SectionGeneral}" FontSize="12" Foreground="#64748b"/>
            </StackPanel>
        </StackPanel>

        <!-- 2. Settings Content Form Card -->
        <Border Grid.Row="1" Background="#ffffff" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <!-- Language Selection Dropdown -->
                <TextBlock Text="{DynamicResource Settings_Language}" FontSize="13" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbLanguage" Height="36" FontSize="13" FontWeight="SemiBold" Padding="10,6" Margin="0,0,0,16"
                          BorderBrush="#94a3b8" Foreground="#0f172a">
                    <ComboBoxItem x:Name="OptLangVi" Content="{DynamicResource Settings_Language_Vi}" Tag="vi"/>
                    <ComboBoxItem x:Name="OptLangEn" Content="{DynamicResource Settings_Language_En}" Tag="en"/>
                </ComboBox>

                <!-- Virtual Host Default TLD -->
                <TextBlock Text="{DynamicResource Settings_Tld}" FontSize="13" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtTld" Height="34" FontSize="13" FontWeight="SemiBold" Padding="8,4" Text="test"
                         BorderBrush="#94a3b8" Foreground="#0f172a" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Settings_TldHint}" FontSize="11" Foreground="#64748b" Margin="0,0,0,16"/>

                <!-- Auto-start services checkbox -->
                <CheckBox x:Name="ChkAutoStart" Content="{DynamicResource Settings_AutoStart}"
                          FontSize="13" FontWeight="SemiBold" Foreground="#0f172a" VerticalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Run on Windows startup checkbox -->
                <CheckBox x:Name="ChkStartWithWindows" Content="{DynamicResource Settings_StartWithWindows}"
                          FontSize="13" FontWeight="SemiBold" Foreground="#0f172a" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 3. Bottom Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Btn_Close}" Style="{StaticResource NeutralButton}" Click="BtnClose_Click" Margin="0,0,10,0"/>
            <Button Content="{DynamicResource Btn_SaveSettings}" Style="{StaticResource PrimarySaveButton}" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
